{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "version": "1.35.0",
  "icons": {
    "16": "assets/256.png",
    "32": "assets/256.png",
    "48": "assets/256.png",
    "128": "assets/256.png"
  },
  "background": {
    "service_worker": "static/js/background.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/256.png",
      "32": "assets/256.png",
      "48": "assets/256.png",
      "128": "assets/256.png"
    },
    "default_title": "__MSG_name__"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["static/js/content.js"],
      "css": ["static/css/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": [
        "assets/256.png",
        "assets/dark-256.png",
        "static/css/*"
      ]
    }
  ]
}
