{
  "manifest_version": 2,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "version": "1.35.0",
  "icons": {
    "16": "assets/16.png",
    "32": "assets/32.png",
    "48": "assets/48.png",
    "128": "assets/128.png"
  },
  "background": {
    "scripts": ["static/js/background.js"]
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/16.png",
      "32": "assets/32.png",
      "48": "assets/48.png",
      "128": "assets/128.png"
    },
    "default_title": "__MSG_name__"
  },
  "permissions": [
    "storage",
    "activeTab",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["static/js/content.js"],
      "css": ["static/css/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "assets/16.png",
    "assets/32.png",
    "assets/48.png",
    "assets/128.png",
    "assets/256.png",
    "assets/dark-16.png",
    "assets/dark-32.png",
    "assets/dark-48.png",
    "assets/dark-128.png",
    "assets/dark-256.png",
    "static/css/*"
  ]
}
